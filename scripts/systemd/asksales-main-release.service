[Unit]
Description=Deploy the latest verified AskSales main commit
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/asksales/poll-production-release.sh
StateDirectory=asksales-public-release
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=160min

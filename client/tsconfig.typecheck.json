{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "*.ts",
    "*.mts"
  ],
  "exclude": [
    "node_modules",
    "next-env.d.ts",
    ".next",
    ".next-*"
  ]
}

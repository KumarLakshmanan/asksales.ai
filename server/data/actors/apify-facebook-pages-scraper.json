        "description": "Facebook url"
      },
      "intro": {
        "type": "string",
        "description": "Intro"
      },
      "pageId": {
        "type": "string",
        "description": "Page id"
      },
      "pageName": {
        "type": "string",
        "description": "Page name"
      },
      "pageUrl": {
        "type": "string",
        "description": "Page url"
      },
      "profilePhoto": {

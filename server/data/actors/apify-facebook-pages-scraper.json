        "type": "string",
        "description": "Title"
      },
      "website": {
        "type": "string",
        "description": "Website"
      },
      "business_price": {
        "type": "string",
        "description": "Business price"
      },
      "email": {
        "type": "string",
        "description": "Email"
      },
      "phone": {
        "type": "string",
        "description": "Phone"
      },
      "priceRange": {
        "type": "string",
        "description": "Price range"
      },
      "instagram": {
        "type": "array",

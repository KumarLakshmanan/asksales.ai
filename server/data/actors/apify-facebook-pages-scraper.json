{
  "id": "apify/facebook-pages-scraper",
  "name": "Facebook Pages Scraper",
  "description": "Extract public data from Facebook Pages. Personal profiles are not supported by this actor.",
  "inputSchema": {
    "title": "facebook-page-scraper",
    "description": "Extract public information from Facebook pages. Get page info, categories, number of likes, address, phone, email, services and rating (whatever is available for the given page). If you need any guidance, just <a href='https://blog.apify.com/how-to-scrape-facebook-pages-posts-comments-photos-and-more/' target='_blank' rel='noopener'>follow this tutorial</a>.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
      "startUrls": {
        "title": "Start urls",
        "description": "Provide urls of Facebook pages you want to get information from. Only works on facebook pages, not personal profiles (not even public ones).",
        "default": [],
        "prefill": [
          {
            "url": "https://www.facebook.com/copperkettleyqr/"
          }
        ],
        "example": [
          {
            "url": "https://www.facebook.com/copperkettleyqr/"
          },
          {
            "url": "https://www.facebook.com/HiltonGardenInnMontrealAirport/"
          }
        ],
        "type": "array",
        "uniqueItems": true,
        "editor": "requestListSources"
      }
    },
    "required": [
      "startUrls"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Categories"
      },
      "info": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Info"
      },
      "websites": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Websites"
      },
      "messenger": {
        "type": "null",
        "description": "Messenger"
      },
      "followers": {
        "type": "number",
        "description": "Followers"
      },
      "followings": {
        "type": "number",
        "description": "Followings"
      },
      "likes": {
        "type": "number",
        "description": "Likes"
      },
      "ratingCount": {
        "type": "number",
        "description": "Rating count"
      },
      "ratingOverall": {
        "type": "number",
        "nullable": true,
        "description": "Rating overall"
      },
      "ad_status": {
        "type": "string",
        "description": "Ad status"
      },
      "address": {
        "type": "string",
        "description": "Address"
      },
      "addressUrl": {
        "type": "string",
        "description": "Address url"
      },
      "business_hours": {
        "type": "string",
        "description": "Business hours"
      },
      "category": {

{
  "id": "powerai/facebook-post-search-scraper",
  "name": "Facebook Post Search Scraper",
  "description": "Extract Facebook posts by keyword with advanced filters, supporting auto-pagination and up to 5000 results per run. Ideal for social media research and content analysis.",
  "inputSchema": {
    "type": "object",
    "schemaVersion": 1,
    "title": "Facebook Post Search Input",
    "properties": {
      "query": {
        "title": "Search Query",
        "type": "string",
        "description": "Keywords to search for Facebook posts.",
        "minLength": 1,
        "default": "ai",
        "editor": "textfield"
      },
      "recent_posts": {
        "title": "Recent Posts Only",
        "type": "boolean",
        "description": "Whether to only search for recent posts.",
        "editor": "checkbox"
      },
      "location_uid": {
        "title": "Location UID",
        "type": "string",
        "description": "Location unique identifier for filtering posts.",
        "editor": "textfield"
      },
      "start_date": {
        "title": "Start Date",
        "type": "string",
        "description": "Start date for filtering posts (format: yyyy-mm-dd).",
        "editor": "textfield",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "end_date": {
        "title": "End Date",
        "type": "string",
        "description": "End date for filtering posts (format: yyyy-mm-dd).",
        "editor": "textfield",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "maxResults": {
        "title": "Max Results",
        "type": "integer",
        "description": "Maximum number of posts to fetch.",
        "default": 10,
        "minimum": 10,
        "maximum": 5000,
        "editor": "number"
      }
    },
    "required": [
      "query"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "album_preview": {
        "type": "...[]",
        "nullable": true,
        "description": "Album preview"
      },
      "attached_event": {
        "type": "null",
        "description": "Attached event"
      },
      "attached_post": {
        "type": "...",
        "nullable": true,
        "description": "Attached post"
      },
      "attached_post_url": {
        "type": "string",
        "nullable": true,
        "description": "Attached post url"
      },
      "author_title": {
        "type": "null",
        "description": "Author title"
      },
      "external_url": {
        "type": "string",
        "nullable": true,
        "description": "External url"
      },
      "image": {
        "type": "...",
        "nullable": true,
        "description": "Image"
      },
      "message": {
        "type": "string",
        "nullable": true,
        "description": "Message"
      },
      "message_rich": {
        "type": "string",
        "nullable": true,
        "description": "Message rich"
      },
      "text_format_metadata": {
        "type": "...",
        "nullable": true,
        "description": "Text format metadata"
      },
      "video": {
        "type": "string",
        "nullable": true,
        "description": "Video"
      },
      "video_files": {
        "type": "...",
        "nullable": true,
        "description": "Video files"
      },
      "video_thumbnail": {
        "type": "string",
        "nullable": true,
        "description": "Video thumbnail"
      },
      "comments_count": {
        "type": "number",
        "description": "Comments count"
      },
      "reactions_count": {
        "type": "number",
        "description": "Reactions count"
      },
      "reshare_count": {
        "type": "number",
        "description": "Reshare count"
      },
      "timestamp": {
        "type": "number",
        "description": "Timestamp"
      },
      "author": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "nullable": true
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "profile_picture_url": {
            "type": "string"
          }
        },
        "description": "Author"
      },
      "reactions": {
        "type": "object",
        "properties": {
          "angry": {
            "type": "number"
          },
          "care": {
            "type": "number"
          },
          "haha": {
            "type": "number"
          },
          "like": {
            "type": "number"
          },
          "love": {
            "type": "number"
          },
          "sad": {
            "type": "number"
          },
          "wow": {
            "type": "number"
          }
        },
        "description": "Reactions"
      },
      "comments_id": {
        "type": "string",
        "description": "Comments id"
      },
      "post_id": {
        "type": "string",
        "description": "Post id"
      },
      "scrapedAt": {
        "type": "string",
        "description": "Scraped at"
      },
      "shares_id": {
        "type": "string",
        "description": "Shares id"
      },
      "type": {
        "type": "string",
        "description": "Type"
      },
      "url": {
        "type": "string",
        "description": "Url"
      }
    }
  },
  "iterate_over": null,
  "skip_if_empty": [],
  "required_inputs": [
    "query"
  ],
  "validation_rules": {}
}

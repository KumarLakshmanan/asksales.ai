{
  "id": "outspoken_strategy/facebook-post-search-scraper",
  "name": "Facebook Post Search Scraper",
  "description": "Search public Facebook posts by keyword with recent-post, location, and date filters. This actor documents itself as a drop-in replacement for powerai/facebook-post-search-scraper.",
  "inputSchema": {
    "type": "object",
    "schemaVersion": 1,
    "title": "Facebook Post Search Input",
    "properties": {
      "query": {
        "title": "Search Query",
        "type": "string",
        "description": "Keywords to search for Facebook posts.",
        "minLength": 1,
        "default": "ai",
        "editor": "textfield"
      },
      "recent_posts": {
        "title": "Recent Posts Only",
        "type": "boolean",
        "description": "Whether to search for recent posts.",
        "editor": "checkbox"
      },
      "location_uid": {
        "title": "Location UID",
        "type": "string",
        "description": "Facebook location identifier used to filter posts.",
        "editor": "textfield"
      },
      "start_date": {
        "title": "Start Date",
        "type": "string",
        "description": "Inclusive start date in yyyy-mm-dd format.",
        "editor": "textfield",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "end_date": {
        "title": "End Date",
        "type": "string",
        "description": "Inclusive end date in yyyy-mm-dd format.",
        "editor": "textfield",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "maxResults": {
        "title": "Max Results",
        "type": "integer",
        "description": "Maximum number of posts to fetch.",
        "default": 10,
        "minimum": 10,
        "maximum": 5000,
        "editor": "number"
      }
    },
    "required": ["query"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "album_preview": { "type": "...[]", "nullable": true },
      "attached_event": { "type": "null", "nullable": true },
      "attached_post": { "type": "...", "nullable": true },
      "attached_post_url": { "type": "string", "nullable": true },
      "author_title": { "type": "string", "nullable": true },
      "external_url": { "type": "string", "nullable": true },
      "image": { "type": "...", "nullable": true },
      "message": { "type": "string", "nullable": true },
      "message_rich": { "type": "string", "nullable": true },
      "text_format_metadata": { "type": "...", "nullable": true },
      "video": { "type": "string", "nullable": true },
      "video_files": { "type": "...", "nullable": true },
      "video_thumbnail": { "type": "string", "nullable": true },
      "comments_count": { "type": "number", "nullable": true },
      "reactions_count": { "type": "number", "nullable": true },
      "reshare_count": { "type": "number", "nullable": true },
      "timestamp": { "type": "number", "nullable": true },
      "author": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "nullable": true },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "profile_picture_url": { "type": "string", "nullable": true }
        }
      },
      "reactions": { "type": "object", "nullable": true },
      "comments_id": { "type": "string", "nullable": true },
      "post_id": { "type": "string" },
      "scrapedAt": { "type": "string", "nullable": true },
      "shares_id": { "type": "string", "nullable": true },
      "type": { "type": "string", "nullable": true },
      "url": { "type": "string" }
    }
  },
  "iterate_over": null,
  "skip_if_empty": [],
  "required_inputs": ["query"],
  "validation_rules": {},
  "pricing": {
    "model": "PAY_PER_EVENT",
    "pricePerResultUsd": 0.015,
    "actorStartUsd": 0.00005,
    "asOf": "2026-09-10"
  },
  "metadata": {
    "providerActorId": "psc8i0vaQOjDqlZIe",
    "latestBuildId": "KvXuf1XuLWNjlt7jE",

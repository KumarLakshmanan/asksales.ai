                      "items": {
                        "type": "number"
                      }
                    },
                    "display_url": {
                      "type": "string"
                    },
                    "expanded_url": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "url": {
            "type": "object",
            "properties": {
              "urls": {
                "type": "array",

            "type": "string"
          }
        },
        "description": "Professional"
      },
      "coverPicture": {
        "type": "string",
        "description": "Cover picture"
      },
      "createdAt": {
        "type": "string",
        "description": "Created at"
      },
      "description": {
        "type": "string",
        "description": "Description"
      },
      "followerOf": {
        "type": "string",
        "description": "Follower of"
      },
      "id": {
        "type": "string",
        "description": "Id"
      },
      "inputSource": {
        "type": "string",
        "description": "Input source"
      },
      "location": {
        "type": "string",
        "description": "Location"
      },
      "name": {
        "type": "string",
        "description": "Name"
      },
      "profileInterstitialType": {
        "type": "string",

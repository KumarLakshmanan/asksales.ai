{
  "id": "save-to-leads",
  "name": "Save to Leads",
  "description": "Save customer and company data to the leads database table. Supports data from LinkedIn, Twitter, Facebook, Instagram, Google Maps, and JustDial.",
  "inputSchema": {
    "title": "Save to Leads Configuration",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
      "iterate_over": {
        "title": "Iterate Over",
        "description": "Path to the array of items to iterate over (e.g., 'results', 'data.profiles', 'places')",
        "type": "string",
        "editor": "textfield",
        "example": "results"
      },
      "field_mapping": {
        "title": "Field Mapping",
        "description": "Map source fields to leads table columns",
        "type": "object",
        "editor": "json",
        "properties": {
          "name": {
            "type": "string",
            "title": "Full Name",
            "description": "Source field for full name",
            "example": "fullName"
          },
          "firstName": {
            "type": "string",
            "title": "First Name",
            "example": "firstName"
          },
          "lastName": {
            "type": "string",
            "title": "Last Name",
            "example": "lastName"
          },
          "email": {
            "type": "string",
            "title": "Email",
            "example": "email"
          },
          "phone": {
            "type": "string",
            "title": "Phone",
            "example": "phone"
          },
          "company": {
            "type": "string",
            "title": "Company Name",
            "example": "company"
          },
          "title": {
            "type": "string",
            "title": "Job Title",
            "example": "title"
          },
          "headline": {
            "type": "string",
            "title": "Headline/Bio",
            "example": "headline"
          },
          "location": {
            "type": "string",
            "title": "Location",
            "example": "location"
          },
          "city": {
            "type": "string",
            "title": "City",
            "example": "city"
          },
          "state": {
            "type": "string",
            "title": "State",
            "example": "state"
          },
          "country": {
            "type": "string",
            "title": "Country",
            "example": "country"
          },
          "countryCode": {
            "type": "string",
            "title": "Country Code",
            "example": "countryCode"
          },
          "profileId": {
            "type": "string",
            "title": "Profile ID",
            "example": "id"
          },
          "publicId": {
            "type": "string",
            "title": "Public ID (LinkedIn)",
            "example": "publicId"
          },
          "linkedinUrl": {
            "type": "string",
            "title": "LinkedIn URL",
            "example": "url"
          },
          "twitterHandle": {
            "type": "string",
            "title": "Twitter Handle",
            "example": "username"
          },
          "twitterUrl": {
            "type": "string",
            "title": "Twitter URL",
            "example": "url"
          },
          "facebookUrl": {
            "type": "string",
            "title": "Facebook URL",
            "example": "url"
          },
          "instagramHandle": {
            "type": "string",
            "title": "Instagram Handle",
            "example": "username"
          },
          "instagramUrl": {
            "type": "string",
            "title": "Instagram URL",
            "example": "url"
          },
          "website": {
            "type": "string",
            "title": "Website",
            "example": "website"
          },
          "profileUrl": {
            "type": "string",
            "title": "Profile URL",
            "example": "url"
          },
          "followersCount": {
            "type": "string",
            "title": "Followers Count",
            "example": "followersCount"
          },
          "followingCount": {
            "type": "string",
            "title": "Following Count",
            "example": "followingCount"
          },
          "connectionsCount": {
            "type": "string",
            "title": "Connections Count",
            "example": "connectionsCount"
          },
          "verified": {
            "type": "string",
            "title": "Verified Status",
            "example": "verified"
          },
          "bio": {
            "type": "string",
            "title": "Bio/About",
            "example": "bio"
          },
          "photo": {
            "type": "string",
            "title": "Profile Photo URL",
            "example": "photo"
          },
          "industry": {
            "type": "string",
            "title": "Industry",
            "example": "industry"
          },
          "companySize": {
            "type": "string",
            "title": "Company Size",
            "example": "companySize"
          },
          "address": {
            "type": "string",
            "title": "Address (Google Maps)",
            "example": "address"
          },
          "placeId": {
            "type": "string",
            "title": "Place ID (Google Maps)",
            "example": "placeId"
          },
          "rating": {
            "type": "string",
            "title": "Rating (Google Maps)",
            "example": "rating"
          },
          "reviewCount": {
            "type": "string",
            "title": "Review Count (Google Maps)",
            "example": "reviewsCount"
          },
          "categories": {
            "type": "string",
            "title": "Categories (Google Maps)",
            "example": "categories"
          },
          "openingHours": {
            "type": "string",
            "title": "Opening Hours (Google Maps)",
            "example": "openingHours"
          },
          "latitude": {
            "type": "string",
            "title": "Latitude",
            "example": "latitude"
          },
          "longitude": {
            "type": "string",
            "title": "Longitude",
            "example": "longitude"
          },
          "googleUrl": {
            "type": "string",
            "title": "Google Maps URL",
            "example": "url"
          },
          "imageUrl": {
            "type": "string",
            "title": "Image URL",
            "example": "imageUrl"
          },
          "source": {
            "type": "string",
            "title": "Source Platform",
            "description": "Scraping source/platform name (e.g., 'linkedin', 'twitter')",
            "example": "linkedin"
          },
          "leadType": {
            "type": "string",
            "title": "Lead Type",
            "description": "Type of lead: profile, company, local_business, etc.",
            "example": "profile"
          },
          "platformType": {
            "type": "string",
            "title": "Platform Type",
            "description": "Platform the lead came from: linkedin, twitter, facebook, instagram, google_maps",
            "example": "linkedin"
          },
          "engagementType": {
            "type": "string",
            "title": "Engagement Type",
            "description": "How lead was discovered: like, comment, retweet, follow, author, search",
            "example": "author"
          },
          "fullName": {
            "type": "string",
            "title": "Full Name (DB column)",
            "description": "Full name stored in full_name column",
            "example": "fullName"
          },
          "companyName": {
            "type": "string",
            "title": "Company Name (DB column)",
            "description": "Company name stored in company_name column",
            "example": "company"
          },
          "about": {
            "type": "string",
            "title": "About",
            "description": "About/bio text",
            "example": "about"
          },
          "profilePicture": {
            "type": "string",
            "title": "Profile Picture",
            "description": "Profile picture URL",
            "example": "profilePicture"
          },
          "twitterUsername": {
            "type": "string",
            "title": "Twitter Username",
            "example": "userName"
          },
          "twitterFollowers": {
            "type": "string",
            "title": "Twitter Followers Count",
            "example": "followersCount"
          },
          "linkedinFollowerCount": {
            "type": "string",
            "title": "LinkedIn Follower Count",
            "example": "followersCount"
          },
          "likeCount": {
            "type": "string",
            "title": "Like Count",
            "example": "likes"
          },
          "postsCount": {
            "type": "string",
            "title": "Posts Count",
            "example": "postsCount"
          },
          "role": {
            "type": "string",
            "title": "Role / Job Title",
            "example": "role"
          },
          "whatsapp": {
            "type": "string",
            "title": "WhatsApp Number",
            "example": "wpnumber"
          },
          "status": {
            "type": "string",
            "title": "Lead Status",
            "description": "Initial status: 'uncontacted', 'new', etc.",
            "example": "uncontacted"
          },
          "registeredAt": {
            "type": "string",
            "title": "Registered At",
            "description": "Account registration date",
            "example": "createdAt"
          },
          "skills": {
            "type": "string",
            "title": "Skills",
            "description": "Skills array (JSON)",
            "example": "skills"
          }
        }
      },
      "batch_insert": {
        "title": "Batch Insert",
        "description": "Insert multiple records at once for better performance",
        "type": "boolean",
        "default": true
      },
      "on_conflict": {
        "title": "On Conflict Strategy",
        "description": "What to do when a lead with the same email already exists",
        "type": "string",
        "enum": ["skip", "update", "error"],
        "enumTitles": ["Skip (ignore duplicate)", "Update (merge data)", "Error (fail on duplicate)"],
        "default": "update"
      }
    },
    "required": ["iterate_over", "field_mapping"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "saved_count": {
        "type": "integer",
        "description": "Number of leads successfully saved"
      },
      "skipped_count": {
        "type": "integer",
        "description": "Number of leads skipped (duplicates)"
      },
      "error_count": {
        "type": "integer",
        "description": "Number of leads that failed to save"
      },
      "saved_ids": {
        "type": "array",
        "items": {
          "type": "integer"
        },
        "description": "IDs of successfully saved leads"
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string"
            },
            "error": {
              "type": "string"
            }
          }
        },
        "description": "List of errors encountered"
      }
    }
  },
  "iterate_over": null,
  "skip_if_empty": [],
  "required_inputs": ["iterate_over", "field_mapping"],
  "validation_rules": {}
}

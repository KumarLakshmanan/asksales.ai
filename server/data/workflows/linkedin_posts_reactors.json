{
  "workflow_id": "linkedin_posts_reactors",
  "platform": "linkedin_posts_reactors",
  "title": "LinkedIn Post Reactors by Profile",
  "description": "Search LinkedIn profiles, scrape their recent posts, then extract people who reacted (liked/celebrated/supported) those posts. Best for building lists of professionals who engage with specific types of content. Use when you want broader engagement signals than commenters \u2014 reactors show interest but at lower effort, resulting in higher volume but slightly lower intent leads.",
  "version": "1.0",
  "tips": "- Reactors show active interest in a topic \u2014 high-quality leads.\n- Use specific job titles for targeted industry profiles.\n- Each post can generate multiple reactors.\n- Keep maxPosts at 3-5 to manage the reactor volume.",
  "nodes": [
    {
      "id": "linkedin_profile_search",
      "type": "actor",
      "position": {
        "x": 100,
        "y": 250
      },
      "data": {
        "label": "LinkedIn Profile Search",
        "actorId": "harvestapi/linkedin-profile-search",
        "actorName": "LinkedIn Profile Search",
        "description": "Search LinkedIn profiles by keywords, job titles, and locations",
        "config": {
          "timeout": 900,
          "memory": 4096
        },
        "inputMapping": {
          "searchQuery": "{{searchQuery}}",
          "maxItems": "{{maxItems}}",
          "locations": "{{locations}}",
          "currentJobTitles": "{{currentJobTitles}}"
        },
        "output_key": "linkedin_profiles",
        "finalValues": {
          "startPage": 1,
          "autoQuerySegmentation": false,
          "profileDeduplicationMode": "off",
          "recentlyChangedJobs": false
        }
      }
    },
    {
      "id": "linkedin_profile_posts",
      "type": "actor",
      "position": {
        "x": 100,
        "y": 450
      },
      "data": {
        "label": "Get Profile Posts",
        "actorId": "harvestapi/linkedin-profile-posts",
        "actorName": "LinkedIn Profile Posts",
        "description": "Extract recent posts from LinkedIn profiles",
        "config": {
          "timeout": 900,
          "memory": 4096
        },
        "inputMapping": {
          "targetUrls": [
            "{_current_item.linkedinUrl}"
          ],
          "maxPosts": 5,
          "postedLimit": "month"
        },
        "iterate_over": "linkedin_profiles",
        "output_key": "linkedin_posts",
        "field_mapping": {
          "targetUrls": "linkedinUrl"
        }
      }
    },
    {
      "id": "linkedin_post_reactions",
      "type": "actor",
      "position": {
        "x": 100,
        "y": 650
      },
      "data": {
        "label": "Get Post Reactions",
        "actorId": "harvestapi/linkedin-post-reactions",
        "actorName": "LinkedIn Post Reactions",
        "description": "Extract people who reacted to posts",
        "config": {
          "timeout": 900,
          "memory": 4096
        },
        "inputMapping": {
          "posts": [
            "{_current_item.linkedinUrl}"
          ],
          "maxItems": 20
        },
        "iterate_over": "linkedin_posts",
        "output_key": "linkedin_reactions",
        "field_mapping": {
          "posts": "linkedinUrl"
        }
      }
    },
    {
      "id": "db_save_posts",
      "type": "saveToPosts",
      "position": {
        "x": 400,
        "y": 450
      },
      "data": {
        "label": "Save LinkedIn Posts",
        "description": "Save LinkedIn posts to posts table",
        "iterate_over": "linkedin_posts",
        "field_mapping": {
          "platform": "'linkedin'",
          "post_id": "entityId",
          "postId": "entityId",
          "content": "content",
          "text": "content",
          "url": "linkedinUrl",
          "postUrl": "linkedinUrl",
          "author_handle": "author.universalName",
          "authorName": "author.name",
          "authorUsername": "author.universalName",
          "authorProfileUrl": "author.linkedinUrl",
          "likes_count": "engagement.likes",
          "likesCount": "engagement.likes",
          "comments_count": "engagement.comments",
          "shares_count": "engagement.shares",
          "posted_at": "postedAt.date",
          "createdAt": "postedAt.date",
          "source": "'linkedin'",
          "mediaUrls": "postImages"
        },
        "batch_insert": true,
        "on_conflict": "skip",
        "nodeId": "save-to-posts"
      }
    },
    {
      "id": "db_save_reactors",
      "type": "saveToLeads",
      "position": {
        "x": 400,
        "y": 650
      },
      "data": {
        "label": "Save Reactors",
        "description": "Save LinkedIn post reactors to leads table",
        "iterate_over": "linkedin_reactions",
        "field_mapping": {
          "platform": "'linkedin'",
          "source": "'linkedin'",
          "leadType": "'profile'",
          "platformType": "'linkedin'",
          "engagementType": "'reactor'",
          "fullName": "actor.name",
          "name": "actor.name",
          "linkedinUrl": "actor.linkedinUrl",
          "profileUrl": "actor.linkedinUrl",
          "headline": "actor.position",
          "title": "actor.position",
          "photo": "actor.pictureUrl",
          "profilePicture": "actor.pictureUrl",
          "profileId": "actor.id",
          "publicId": "actor.publicIdentifier",
          "status": "'uncontacted'"
        },
        "batch_insert": true,
        "on_conflict": "skip",
        "nodeId": "save-to-leads"
      }
    }
  ],
  "edges": [
    {
      "id": "e_search_to_posts",
      "source": "linkedin_profile_search",
      "target": "linkedin_profile_posts",
      "animated": true
    },
    {
      "id": "e_posts_to_reactions",
      "source": "linkedin_profile_posts",
      "target": "linkedin_post_reactions",
      "animated": true
    },
    {
      "id": "e_posts_to_save",
      "source": "linkedin_profile_posts",
      "target": "db_save_posts",
      "animated": true
    },
    {
      "id": "e_reactions_to_save",
      "source": "linkedin_post_reactions",
      "target": "db_save_reactors",
      "animated": true
    },
    {
      "id": "e_saved_posts_to_reactors",
      "source": "db_save_posts",
      "target": "db_save_reactors",
      "animated": true
    }
  ],
  "mappings": []
}

{
  "name": "salesmarketing-server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon index.ts",
    "build": "esbuild index.ts --platform=node --packages=external --bundle --format=esm --minify --outdir=dist",
    "build:worker": "esbuild workers/worker-entry.ts --platform=node --packages=external --bundle --format=esm --minify --outdir=dist",
    "build:all": "pnpm run build && pnpm run build:worker",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "lint": "cross-env NODE_OPTIONS='--max-old-space-size=4096' eslint . --ext .ts",
    "typecheck": "cross-env NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit",
    "db:run-migrations": "node scripts/migrate.mjs up",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:status": "node scripts/migrate.mjs status",
    "migrate:create": "node scripts/migrate.mjs create",
    "migrate:mark-applied": "node scripts/migrate.mjs mark-applied",
    "db:migrate:test": "cross-env NODE_ENV=test DB_NAME=${DB_NAME:?} node scripts/migrate.mjs up",
    "db:setup": "node scripts/migrate.mjs up",
    "outreach:inbox:reconcile": "tsx scripts/reconcile-outreach-inbox.ts",
    "outreach:tracking:backfill": "tsx scripts/backfill-outreach-batches.ts",
    "support:embeddings:repair": "tsx scripts/repair-support-kb-embeddings.ts",
    "support:embeddings:verify": "tsx scripts/repair-support-kb-embeddings.ts --verify-only",
    "support:architecture:audit": "tsx scripts/audit-support-architecture.ts",
    "support:pii-redaction:repair": "tsx scripts/repair-pii-redaction.ts",
    "support:playbook:migrate-template": "tsx scripts/migrate-support-playbook-template.ts",
    "support:playbook:publish-code-template": "tsx scripts/publish-code-support-template.ts",
    "support:crm-identities:backfill": "tsx scripts/backfill-crm-channel-identities.ts",
    "knowledge:v2:prepare": "tsx scripts/migrate-knowledge-v2.ts --prepare",
    "knowledge:v2:cutover": "tsx scripts/migrate-knowledge-v2.ts --cutover",
    "knowledge:v2:rollback": "tsx scripts/migrate-knowledge-v2.ts --rollback",
    "knowledge:maintenance": "tsx scripts/run-knowledge-maintenance.ts",
    "knowledge:index:rotate": "tsx scripts/rotate-knowledge-index.ts",
    "knowledge:architecture:audit": "tsx scripts/audit-knowledge-architecture.ts",
    "test:knowledge:acceptance": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand tests/knowledgeEvidenceArchitecture.test.ts",
    "test:media:acceptance": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand tests/supportMediaArchitecture.test.ts",
    "test:support:acceptance": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand tests/supportOrchestrationCore.test.ts tests/supportPolicyGovernance.test.ts tests/newSupportPipeline.test.ts tests/agentRouter.test.ts tests/contactValidation.test.ts tests/defaultSupportConfiguration.test.ts tests/agentPromptBuilder.test.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "canary:provider": "tsx scripts/run-provider-canary.ts",
    "qa:proposal:live": "tsx scripts/verify-live-proposal.ts"
  },
  "dependencies": {
    "@apify/actors-mcp-server": "^0.14.3",
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/s3-request-presigner": "^3.990.0",
    "@bull-board/api": "^6.20.6",
    "@bull-board/express": "^6.20.6",
    "@bull-board/ui": "^6.20.6",
    "@e965/xlsx": "^0.20.3",
    "@google/genai": "^1.44.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@mastra/core": "^1.22.0",
    "@neondatabase/serverless": "^0.10.4",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@pydantic/genai-prices": "^0.0.56",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/jsonpath": "^0.2.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/mustache": "^4.2.6",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "@types/uuid": "^10.0.0",
    "apify-client": "^2.25.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.69.2",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.1",
    "fast-xml-parser": "^5.10.1",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^10.6.2",
    "googleapis": "^169.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "ipaddr.js": "2.2.0",
    "js-tiktoken": "^1.0.21",
    "json2csv": "^6.0.0-alpha.2",
    "jsonpath": "^1.1.1",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.38.20",
    "mailparser": "^3.9.15",
    "mammoth": "^1.12.0",
    "memorystore": "^1.6.7",
    "multer": "^2.5.0",
    "mustache": "^4.2.0",
    "nanoid": "^5.1.16",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.2.1",
    "openai": "^6.9.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright-core": "^1.62.1",
    "postgres": "^3.4.7",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.9.3",
    "sharp": "^0.35.5",
    "undici": "7.30.1",
    "uuid": "^13.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.24.5",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@jest/globals": "^30.2.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.10.1",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.47.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
